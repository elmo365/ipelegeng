<?xml version="1.0" encoding="utf-8"?>
<!--
  API 21+ variant. Identical to the base drawable on purpose: the stock file
  used `?android:colorBackground`, which resolves to plain white from
  Theme.Light and plain black from Theme.Black, so every launch flashed a
  colour the app never uses.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ipelegeLaunchBg" />
</layer-list>
