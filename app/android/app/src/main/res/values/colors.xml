<?xml version="1.0" encoding="utf-8"?>
<!--
  The cold-start window colour, before Flutter draws its first frame.

  It is the palette's `screenBg2` — the tinted page — not white, because a
  white window followed by a tinted page is a visible flash on every launch.
  Keep this in step with AppPalette.light.screenBg2 in lib/theme/tokens.dart.
-->
<resources>
    <color name="ipelegeLaunchBg">#FFEDF3F8</color>

    <!--
      The adaptive icon's background layer. White, because the supplied
      foreground is the dark mark and `appicon-light.png` sets it on white.
      Not theme-dependent: a launcher icon that changed colour with the
      system theme would stop being recognisable on the home screen.
    -->
    <color name="ipelegeIconBg">#FFFFFFFF</color>
</resources>
